// OS Lab database schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum ModuleId {
  process
  cpu
  memory
  paging
  disk
}

enum SimulationMode {
  visual
  text
  compare
}

/// A student account. Either passwordHash (email sign-up) or googleId is set, or both
/// when a Google sign-in is linked to an existing email account.
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String?
  googleId     String?      @unique
  avatarUrl    String?
  provider     AuthProvider @default(LOCAL)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  simulations      SimulationRun[]
  exerciseAttempts ExerciseAttempt[]
  quizAttempts     QuizAttempt[]
  topicsRead       TopicProgress[]
  favourites       Favourite[]
  resourceMarks    ResourceMark[]
}

/// One run of a simulator (visual playback, text calculation or comparison).
model SimulationRun {
  id        String         @id @default(cuid())
  userId    String
  module    ModuleId
  algorithm String
  mode      SimulationMode
  summary   String?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, module])
}

/// A graded practice exercise. Exercises are deterministic in (kind, difficulty, seed),
/// so the server regenerates and grades them; the stored answers allow review.
model ExerciseAttempt {
  id         String   @id @default(cuid())
  userId     String
  kind       String
  difficulty String
  seed       Int
  answers    Json
  correct    Int
  total      Int
  score      Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  module    ModuleId
  score     Int
  total     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, module])
}

model TopicProgress {
  userId String
  slug   String
  readAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, slug])
}

/// Favourite algorithm, keyed "<module>:<algorithm>", e.g. "cpu:RR".
model Favourite {
  userId    String
  key       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

/// A student's bookmark ("saved") and completion ("done") state for a learning
/// resource from the Resources library. The catalogue itself is static content in
/// the frontend; resourceId is its slug, e.g. "ostep".
model ResourceMark {
  userId     String
  resourceId String
  saved      Boolean  @default(false)
  completed  Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, resourceId])
}
